{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server"
      ]
    },
    "omnidimension": {
      "command": "npx",
      "args": [
        "-y",
        "@omnidim-ai/mcp-server"
      ],
      "env": {
        "OMNIDIM_API_KEY": "${OMNIDIM_API_KEY}"
      }
    }
  }
}